+import { useEffect, useState } from 'react';
+import { useProjectStore } from '@/stores/projectStore';
+import {
+  llmBudgetStatus,
+  LLM_ECONOMY_EVENT,
+  readLlmBudget,
+  readLlmStorageState,
+  readLlmSpend,
+  readLlmUsageSummary,
+} from '@/services/llmEconomy/llmBudget';
+import { isLocalProvider, leavesDevice } from '@/services/llmEconomy/costMeter';
+
+const snapshot = (projectId: string | null) => {
+  if (!projectId) return null;
+  const spend = readLlmSpend(projectId);
+  const budget = readLlmBudget(projectId);
+  const storage = readLlmStorageState(projectId);
+  return {
+    spend,
+    budget,
+    status: llmBudgetStatus(spend, budget),
+    summary: readLlmUsageSummary(projectId),
+    storage,
+  };
+};
+
+/** Live month-to-date LLM spend, savings, cache hits and budget status. */
+export const useLlmEconomy = (explicitProjectId?: string | null, providerId = '') => {
+  const storeProjectId = useProjectStore((state) => state.activeProjectId);
+  const projectId = explicitProjectId !== undefined ? explicitProjectId : storeProjectId;
+  const [state, setState] = useState(() => snapshot(projectId));
+
+  useEffect(() => {
+    const refresh = () => setState(snapshot(projectId));
+    refresh();
+    window.addEventListener(LLM_ECONOMY_EVENT, refresh);
+    window.addEventListener('storage', refresh);
+    return () => {
+      window.removeEventListener(LLM_ECONOMY_EVENT, refresh);
+      window.removeEventListener('storage', refresh);
+    };
+  }, [projectId]);
+
+  return {
+    projectId,
+    spend: state?.spend ?? null,
+    budget: state?.budget ?? null,
+    status: state?.status ?? null,
+    summary: state?.summary ?? null,
+    storage: state?.storage ?? null,
+    isLocal: isLocalProvider(providerId),
+    leavesDevice: leavesDevice(providerId),
+  };
+};
diff --git a/src/services/llmEconomy/budgetReservation.ts b/src/services/llmEconomy/budgetReservation.ts
new file mode 100644
index 00000000..8817563a
--- /dev/null
+++ b/src/services/llmEconomy/budgetReservation.ts
@@ -0,0 +1,20 @@
+import { readLlmBudget, readLlmSpend, readLlmStorageState, withinProjectBudget } from './llmBudget';
+
+const pending = new Map<string, number>();
+
+export const reserveProjectBudget = (projectId: string, local: boolean, estimatedCost: number | null, now: Date): (() => void) => {
+  if (local) return () => undefined;
+  const budget = readLlmBudget(projectId);
+  const storage = readLlmStorageState(projectId);
+  if (storage.budget === 'invalid' || storage.budget === 'unavailable') throw new Error('Project LLM budget storage is unavailable or invalid; refusing an unpriced cloud call');
+  if (budget.monthlyLimitUsd !== null && (storage.spend === 'invalid' || storage.spend === 'unavailable')) throw new Error('Project LLM spend storage is unavailable or invalid; refusing a cloud call under an active budget');
+  if (budget.monthlyLimitUsd === null) return () => undefined;
+  if (estimatedCost === null) throw new Error('Cannot execute unpriced external LLM call under active project budget limit');
+  const reserved = pending.get(projectId) ?? 0;
+  if (!withinProjectBudget(projectId, estimatedCost, now) || readLlmSpend(projectId, now).spentUsd + reserved + estimatedCost > budget.monthlyLimitUsd) throw new Error('Project LLM budget exceeded');
+  pending.set(projectId, reserved + estimatedCost);
+  return () => {
+    const next = (pending.get(projectId) ?? estimatedCost) - estimatedCost;
+    if (next > 0) pending.set(projectId, next); else pending.delete(projectId);
+  };
+};
diff --git a/src/services/llmEconomy/cacheStore.ts b/src/services/llmEconomy/cacheStore.ts
new file mode 100644
index 00000000..4b36db64
--- /dev/null
+++ b/src/services/llmEconomy/cacheStore.ts
@@ -0,0 +1,74 @@
+import { readStorage, removeStorage, writeStorage } from '@/services/storage';
+
+export interface TaskRecord {
+  projectId: string;
+  providerId: string;
+  model: string;
+  prompt: string;
+  vector?: ArrayLike<number>;
+  response: string;
+  costUsd: number | null;
+  at: number;
+}
+
+export const CACHE_TTL_MS = 24 * 60 * 60 * 1000;
+export const MAX_PROJECT_TASKS = 100;
+const CACHE_KEY_SUFFIX = '_llm_cache_v1';
+const MAX_CACHE_TEXT = 100_000;
+const MAX_CACHE_VECTOR = 2048;
+const MAX_CACHE_BYTES = 2_000_000;
+const memory = new Map<string, TaskRecord[]>();
+const loaded = new Set<string>();
+const known = new Set<string>();
+
+const keyFor = (projectId: string): string => `seomi_project_${projectId}${CACHE_KEY_SUFFIX}`;
+const prune = (records: TaskRecord[], now: number): TaskRecord[] => records
+  .filter((record) => now - record.at <= CACHE_TTL_MS).slice(-MAX_PROJECT_TASKS);
+
+const validRecord = (projectId: string, value: unknown): value is TaskRecord => {
+  if (!value || typeof value !== 'object') return false;
+  const item = value as Partial<TaskRecord>;
+  return item.projectId === projectId && typeof item.providerId === 'string' && typeof item.model === 'string'
+    && typeof item.prompt === 'string' && item.prompt.length <= MAX_CACHE_TEXT
+    && typeof item.response === 'string' && item.response.length <= MAX_CACHE_TEXT
+    && (item.costUsd === null || (typeof item.costUsd === 'number' && Number.isFinite(item.costUsd) && item.costUsd >= 0))
+    && typeof item.at === 'number' && Number.isFinite(item.at)
+    && (item.vector === undefined || (Array.isArray(item.vector) && item.vector.length <= MAX_CACHE_VECTOR
+      && item.vector.every((entry) => typeof entry === 'number' && Number.isFinite(entry))));
+};
+
+export const loadProject = (projectId: string, now: number): TaskRecord[] => {
+  known.add(projectId);
+  if (loaded.has(projectId)) return memory.get(projectId) ?? [];
+  loaded.add(projectId);
+  const raw = readStorage(keyFor(projectId));
+  if (raw === null) { const empty: TaskRecord[] = []; memory.set(projectId, empty); return empty; }
+  try {
+    if (raw.length > MAX_CACHE_BYTES) throw new Error('cache payload exceeds bound');
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed)) throw new Error('cache record must be an array');
+    const records = parsed.filter((item): item is TaskRecord => validRecord(projectId, item));
+    const pruned = prune(records, now);
+    memory.set(projectId, pruned);
+    return pruned;
+  } catch {
+    const empty: TaskRecord[] = [];
+    memory.set(projectId, empty);
+    return empty;
+  }
+};
+
+export const persistProject = (projectId: string, records: TaskRecord[]): void => {
+  try { writeStorage(keyFor(projectId), JSON.stringify(records.slice(-MAX_PROJECT_TASKS))); } catch { /* volatile fallback */ }
+};
+
+export const clearProjectCacheData = (projectId: string): void => {
+  memory.delete(projectId); loaded.delete(projectId); known.delete(projectId); removeStorage(keyFor(projectId));
+};
+export const clearAllCacheData = (): void => {
+  for (const projectId of known) removeStorage(keyFor(projectId));
+  memory.clear(); loaded.clear(); known.clear();
+};
+export const projectCacheSize = (projectId?: string): number => projectId
+  ? (memory.get(projectId)?.length ?? 0)
+  : Array.from(memory.values()).reduce((sum, records) => sum + records.length, 0);
diff --git a/src/services/llmEconomy/executionState.ts b/src/services/llmEconomy/executionState.ts
new file mode 100644
index 00000000..389c7f18
--- /dev/null
+++ b/src/services/llmEconomy/executionState.ts
@@ -0,0 +1,24 @@
+const inFlight = new Map<string, Promise<unknown>>();
+export const IN_FLIGHT_TTL_MS = 5 * 60 * 1000;
+export const MAX_IN_FLIGHT = 64;
+
+/** Shares bounded provider work only; caller-specific policy is applied outside. */
+export const shareInFlight = <T>(key: string, run: () => Promise<T>): Promise<T> => {
+  const previous = inFlight.get(key);
+  if (previous) return previous as Promise<T>;
+  const current = run();
+  inFlight.set(key, current);
+  const timer = setTimeout(() => {
+    if (inFlight.get(key) === current) inFlight.delete(key);
+  }, IN_FLIGHT_TTL_MS);
+  (timer as unknown as { unref?: () => void }).unref?.();
+  while (inFlight.size > MAX_IN_FLIGHT) {
+    const oldest = inFlight.keys().next().value;
+    if (typeof oldest !== 'string') break;
+    inFlight.delete(oldest);
+  }
+  return current.finally(() => {
+    clearTimeout(timer);
+    if (inFlight.get(key) === current) inFlight.delete(key);
+  });
+};
diff --git a/src/services/llmEconomy/llmBudget.ts b/src/services/llmEconomy/llmBudget.ts
new file mode 100644
index 00000000..30983c51
--- /dev/null
+++ b/src/services/llmEconomy/llmBudget.ts
@@ -0,0 +1,150 @@
+import i18n from '@/i18n';
+import { isStorageAvailable, readStorage, removeStorage, writeStorage } from '@/services/storage';
+import type { UsageSummary } from './costMeter';
+
+export const LLM_ECONOMY_EVENT = 'seomi:llm-economy-cost';
+export const MAX_LLM_MONTHLY_LIMIT_USD = 100_000;
+
+export interface LlmBudget { monthlyLimitUsd: number | null; warnAtPercent: number }
+export interface LlmLastCall { providerId: string; model?: string; costUsd: number | null; savedUsd: number; cached: boolean; local: boolean; at: string }
+export interface LlmSpend {
+  month: string; spentUsd: number; savedUsd: number; cacheHits: number; calls: number;
+  unknownCostCalls?: number;
+  lastCostByProvider: Record<string, number>; lastCall: LlmLastCall | null;
+}
+export type BudgetLevel = 'none' | 'ok' | 'warning' | 'exceeded';
+export type LlmStorageState = 'missing' | 'valid' | 'invalid' | 'unavailable';
+
+const budgetKey = (p: string) => `seomi_project_${p}_llm_budget_v1`;
+const spendKey = (p: string) => `seomi_project_${p}_llm_spend_v1`;
+const DEFAULT_BUDGET: LlmBudget = { monthlyLimitUsd: null, warnAtPercent: 80 };
+
+const isPlainObject = (value: unknown): value is Record<string, unknown> => Boolean(value && typeof value === 'object' && !Array.isArray(value));
+const validBudgetShape = (value: Record<string, unknown>): boolean =>
+  (!('monthlyLimitUsd' in value) || value.monthlyLimitUsd === null || finiteCost(value.monthlyLimitUsd))
+  && (!('warnAtPercent' in value) || (typeof value.warnAtPercent === 'number' && Number.isInteger(value.warnAtPercent) && value.warnAtPercent >= 1 && value.warnAtPercent <= 100));
+const validSpendShape = (value: Record<string, unknown>): boolean => {
+  const numeric = ['spentUsd', 'savedUsd'];
+  const counters = ['cacheHits', 'calls', 'unknownCostCalls'];
+  const providerCosts = !('lastCostByProvider' in value) || (isPlainObject(value.lastCostByProvider)
+    && Object.values(value.lastCostByProvider).every((cost) => finiteCost(cost)));
+  const lastCall = !('lastCall' in value) || value.lastCall === null || isPlainObject(value.lastCall);
+  return (!('month' in value) || typeof value.month === 'string')
+    && numeric.every((key) => !(key in value) || finiteCost(value[key]))
+    && counters.every((key) => !(key in value) || (typeof value[key] === 'number' && Number.isInteger(value[key]) && (value[key] as number) >= 0))
+    && providerCosts && lastCall;
+};
+
+const storageState = (key: string, kind: 'budget' | 'spend'): LlmStorageState => {
+  if (!isStorageAvailable()) return 'unavailable';
+  const raw = readStorage(key);
+  if (raw === null) return 'missing';
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!isPlainObject(parsed)) return 'invalid';
+    return (kind === 'budget' ? validBudgetShape(parsed) : validSpendShape(parsed)) ? 'valid' : 'invalid';
+  } catch { return 'invalid'; }
+};
+
+export const readLlmStorageState = (projectId: string): { budget: LlmStorageState; spend: LlmStorageState } => ({
+  budget: storageState(budgetKey(projectId), 'budget'),
+  spend: storageState(spendKey(projectId), 'spend'),
+});
+
+export const monthKey = (now = new Date()): string => `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
+const finiteCost = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v) && v >= 0 && v <= MAX_LLM_MONTHLY_LIMIT_USD;
+
+const readJson = (key: string): Record<string, unknown> => {
+  try {
+    const val: unknown = JSON.parse(readStorage(key) || '{}');
+    return val && typeof val === 'object' && !Array.isArray(val) ? (val as Record<string, unknown>) : {};
+  } catch { return {}; }
+};
+
+export const readLlmBudget = (projectId: string): LlmBudget => {
+  const s = readJson(budgetKey(projectId));
+  return {
+    monthlyLimitUsd: finiteCost(s.monthlyLimitUsd) ? s.monthlyLimitUsd : null,
+    warnAtPercent: typeof s.warnAtPercent === 'number' && Number.isInteger(s.warnAtPercent) && s.warnAtPercent >= 1 && s.warnAtPercent <= 100 ? s.warnAtPercent : DEFAULT_BUDGET.warnAtPercent,
+  };
+};
+
+export const writeLlmBudget = (projectId: string, budget: LlmBudget): LlmBudget => {
+  if (budget.monthlyLimitUsd !== null && !(finiteCost(budget.monthlyLimitUsd) && budget.monthlyLimitUsd <= MAX_LLM_MONTHLY_LIMIT_USD)) throw new Error(i18n.t('dataforseoCost.invalidLimit'));
+  if (!Number.isInteger(budget.warnAtPercent) || budget.warnAtPercent < 1 || budget.warnAtPercent > 100) throw new Error(i18n.t('dataforseoCost.invalidWarn'));
+  if (!writeStorage(budgetKey(projectId), JSON.stringify(budget))) throw new Error('Unable to persist the project LLM budget');
+  window.dispatchEvent(new CustomEvent(LLM_ECONOMY_EVENT, { detail: { projectId, budget } }));
+  return budget;
+};
+
+export const clearProjectLlmBudgetAndSpend = (projectId: string): void => {
+  removeStorage(budgetKey(projectId));
+  removeStorage(spendKey(projectId));
+  window.dispatchEvent(new CustomEvent(LLM_ECONOMY_EVENT, { detail: { projectId, cleared: true } }));
+};
+
+export const readLlmSpend = (projectId: string, now = new Date()): LlmSpend => {
+  const s = readJson(spendKey(projectId));
+  const month = monthKey(now);
+  const costs = s.lastCostByProvider && typeof s.lastCostByProvider === 'object' ? (s.lastCostByProvider as Record<string, unknown>) : {};
+  const lastCostByProvider = Object.fromEntries(Object.entries(costs).filter((e): e is [string, number] => finiteCost(e[1])).slice(0, 50));
+  const last = s.lastCall as Partial<LlmLastCall> | undefined;
+  const lastCost = last && (last.costUsd === null || finiteCost(last.costUsd)) ? last.costUsd : null;
+  const lastCall: LlmLastCall | null = last && typeof last.providerId === 'string' && (last.costUsd === null || finiteCost(last.costUsd)) && typeof last.at === 'string'
+    ? { providerId: last.providerId, model: typeof last.model === 'string' ? last.model : undefined, costUsd: lastCost, savedUsd: finiteCost(last.savedUsd) ? last.savedUsd : 0, cached: Boolean(last.cached), local: Boolean(last.local), at: last.at }
+    : null;
+  if (s.month !== month) return { month, spentUsd: 0, savedUsd: 0, cacheHits: 0, calls: 0, lastCostByProvider, lastCall };
+  return {
+    month, spentUsd: finiteCost(s.spentUsd) ? s.spentUsd : 0, savedUsd: finiteCost(s.savedUsd) ? s.savedUsd : 0,
+    cacheHits: typeof s.cacheHits === 'number' && Number.isInteger(s.cacheHits) && s.cacheHits >= 0 ? s.cacheHits : 0,
+    calls: typeof s.calls === 'number' && Number.isInteger(s.calls) && s.calls >= 0 ? s.calls : 0,
+    lastCostByProvider, lastCall, ...(typeof s.unknownCostCalls === 'number' && Number.isInteger(s.unknownCostCalls) && s.unknownCostCalls > 0 ? { unknownCostCalls: s.unknownCostCalls } : {}),
+  };
+};
+
+export const recordLlmCost = (
+  projectId: string,
+  entry: { providerId: string; model?: string; costUsd: number | null; savedUsd?: number; cached?: boolean; local?: boolean },
+  now = new Date(),
+): LlmSpend => {
+  const spend = readLlmSpend(projectId, now);
+  const cached = Boolean(entry.cached);
+  const local = Boolean(entry.local);
+  const cost = entry.costUsd === null ? null : (finiteCost(entry.costUsd) ? entry.costUsd : null);
+  const spentDiff = cached || local || cost === null ? 0 : cost;
+  const savedDiff = cached || local ? (finiteCost(entry.savedUsd) ? entry.savedUsd : (cost ?? 0)) : 0;
+  const next: LlmSpend = {
+    ...spend,
+    spentUsd: Math.round((spend.spentUsd + spentDiff) * 1e6) / 1e6,
+    savedUsd: Math.round((spend.savedUsd + savedDiff) * 1e6) / 1e6,
+    cacheHits: spend.cacheHits + (cached ? 1 : 0),
+    calls: spend.calls + 1,
+    lastCostByProvider: cost !== null ? { ...spend.lastCostByProvider, [entry.providerId]: cost } : spend.lastCostByProvider,
+    lastCall: { providerId: entry.providerId, model: entry.model, costUsd: cost, savedUsd: savedDiff, cached, local, at: now.toISOString() },
+    ...(cost === null && !cached && !local ? { unknownCostCalls: (spend.unknownCostCalls ?? 0) + 1 } : spend.unknownCostCalls ? { unknownCostCalls: spend.unknownCostCalls } : {}),
+  };
+  try { writeStorage(spendKey(projectId), JSON.stringify(next)); } catch { /* Storage fallback */ }
+  window.dispatchEvent(new CustomEvent(LLM_ECONOMY_EVENT, { detail: { projectId, entry } }));
+  return next;
+};
+
+export const llmBudgetStatus = (spend: LlmSpend, budget: LlmBudget): { level: BudgetLevel; percent: number | null; remainingUsd: number | null } => {
+  if (budget.monthlyLimitUsd === null) return { level: 'none', percent: null, remainingUsd: null };
+  const limit = budget.monthlyLimitUsd;
+  const percent = limit === 0 ? (spend.spentUsd > 0 ? 100 : 0) : Math.min(999, (spend.spentUsd / limit) * 100);
+  const level: BudgetLevel = spend.spentUsd >= limit ? 'exceeded' : percent >= budget.warnAtPercent ? 'warning' : 'ok';
+  return { level, percent, remainingUsd: Math.max(0, Math.round((limit - spend.spentUsd) * 1e6) / 1e6) };
+};
+
+export const withinProjectBudget = (projectId: string, nextCostUsd: number | null, now = new Date()): boolean => {
+  const budget = readLlmBudget(projectId);
+  if (budget.monthlyLimitUsd === null) return true;
+  if (nextCostUsd === null) return false;
+  return readLlmSpend(projectId, now).spentUsd + nextCostUsd <= budget.monthlyLimitUsd;
+};
+export const readLlmUsageSummary = (projectId: string, now = new Date()): UsageSummary => {
+  const spend = readLlmSpend(projectId, now);
+  const budget = readLlmBudget(projectId);
+  const status = llmBudgetStatus(spend, budget);
+  return { spentUsd: spend.spentUsd, savedUsd: spend.savedUsd, cacheHits: spend.cacheHits, calls: spend.calls, remainingUsd: status.remainingUsd, overBudget: status.level === 'exceeded', ...(spend.unknownCostCalls ? { unknownCostCalls: spend.unknownCostCalls } : {}) };
+};
diff --git a/src/services/llmEconomy/orchestrator.ts b/src/services/llmEconomy/orchestrator.ts
new file mode 100644
index 00000000..4a6ee5ec
--- /dev/null
+++ b/src/services/llmEconomy/orchestrator.ts
@@ -0,0 +1,149 @@
+import { isLocalProvider, pickBatchProvider } from './costMeter';
+import { validateYmylClaim, type YmylSourceInput } from './factGate';
+import { recordLlmCost } from './llmBudget';
+import { buildTaskKey, findProjectCachedTask, resolveCacheSavings, storeProjectTask } from './semanticCache';
+import { shareInFlight } from './executionState';
+import { reserveProjectBudget } from './budgetReservation';
+export { IN_FLIGHT_TTL_MS, MAX_IN_FLIGHT } from './executionState';
+
+export interface ExecuteOptions {
+  projectId: string;
+  configuredProviders: string[];
+  providerId?: string;
+  /** Actual adapter transport; cloud is required for local_cli-backed hosted IDs. */
+  transport?: 'local' | 'cloud';
+  model?: string;
+  prompt: string;
+  vector?: ArrayLike<number> | null;
+  cacheThreshold?: number;
+  batchSize?: number;
+  batchThreshold?: number;
+  estimatedCostUsd?: number | null;
+  actualCostUsd?: number | null;
+  ymyl?: boolean;
+  sources?: YmylSourceInput[];
+  run: (providerId: string) => Promise<{ text: string; actualCostUsd?: number | null; transport?: 'local' | 'cloud' }>;
+  now?: Date;
+}
+
+export interface ExecutionResult {
+  text: string;
+  providerId: string;
+  model: string;
+  costUsd: number | null;
+  savedUsd: number;
+  cached: boolean;
+  matchType?: 'exact' | 'semantic';
+  local: boolean;
+  leavesDevice: boolean;
+  factGatePassed: boolean;
+  rejectedClaims: string[];
+  needsHumanApproval: boolean;
+}
+
+export class LlmFactGateBlockedError extends Error {
+  readonly code = 'llm-fact-gate-blocked' as const;
+  readonly factGatePassed = false;
+  readonly needsHumanApproval = true;
+  constructor(readonly rejectedClaims: string[]) {
+    super(`YMYL fact gate rejected unsupported claims: ${rejectedClaims.join(', ')}`);
+    this.name = 'LlmFactGateBlockedError';
+  }
+}
+
+const validateCallerResult = (result: ExecutionResult, options: ExecuteOptions): ExecutionResult => {
+  if (!options.ymyl) return result;
+  if (!result.factGatePassed) return result;
+  const check = validateYmylClaim(result.text, options.sources ?? []);
+  if (!check.allowed) return { ...result, text: '', factGatePassed: false, rejectedClaims: check.rejectedValues, needsHumanApproval: true };
+  return { ...result, factGatePassed: true, rejectedClaims: [], needsHumanApproval: true };
+};
+
+const blockedResult = (base: ExecutionResult, rejectedClaims: string[]): ExecutionResult => ({
+  ...base, text: '', factGatePassed: false, rejectedClaims, needsHumanApproval: true,
+});
+
+export const executeWithEconomy = async (options: ExecuteOptions): Promise<ExecutionResult> => {
+  const chosenProvider = options.providerId
+    ?? (options.batchSize !== undefined ? pickBatchProvider(options.configuredProviders, options.batchSize, options.batchThreshold) : null)
+    ?? options.configuredProviders[0]
+    ?? '';
+  if (!chosenProvider) throw new Error('No AI provider configured');
+
+  const model = options.model ?? 'default';
+  const key = `${options.projectId}\u0000${buildTaskKey(chosenProvider, model, options.prompt)}`;
+  // Share provider work, but never share a caller's fact approval.
+  return shareInFlight(key, () => executeWithEconomyUnshared(options, chosenProvider, model))
+    .then((result) => validateCallerResult(result, options));
+};
+
+const executeWithEconomyUnshared = async (options: ExecuteOptions, chosenProvider: string, model: string): Promise<ExecutionResult> => {
+  const local = isLocalProvider(chosenProvider);
+  const transport = options.transport ?? (local ? 'local' : 'cloud');
+  if (transport === 'local' && !local) throw new Error('Local AI transport requires a known local provider');
+  const executesLocally = transport === 'local';
+  const willLeave = transport === 'cloud';
+  const now = options.now ?? new Date();
+
+  // 1. Project-scoped cache: exact key lookup and cosine semantic lookup
+  const hit = findProjectCachedTask(options.projectId, model, options.prompt, options.vector, options.cacheThreshold, chosenProvider, now.getTime());
+  if (hit) {
+    const savings = resolveCacheSavings(hit.record.costUsd);
+    const ymylCheck = options.ymyl ? validateYmylClaim(hit.record.response, options.sources ?? []) : null;
+    if (ymylCheck && !ymylCheck.allowed) {
+      return blockedResult({
+        text: '', providerId: chosenProvider, model, costUsd: 0, savedUsd: savings.savedUsd,
+        cached: true, matchType: hit.matchType, local, leavesDevice: willLeave,
+        factGatePassed: false, rejectedClaims: ymylCheck.rejectedValues, needsHumanApproval: true,
+      }, ymylCheck.rejectedValues);
+    }
+    recordLlmCost(options.projectId, { providerId: chosenProvider, model, costUsd: 0, savedUsd: savings.savedUsd, cached: true, local: executesLocally }, now);
+    return {
+      text: hit.record.response, providerId: chosenProvider, model, costUsd: 0, savedUsd: savings.savedUsd,
+      cached: true, matchType: hit.matchType, local: executesLocally, leavesDevice: willLeave,
+      factGatePassed: ymylCheck ? ymylCheck.allowed : true,
+      rejectedClaims: ymylCheck ? ymylCheck.rejectedValues : [],
+      needsHumanApproval: Boolean(options.ymyl),
+    };
+  }
+
+  const estimatedCost = executesLocally ? 0 : (options.estimatedCostUsd ?? options.actualCostUsd ?? null);
+  const releaseBudget = reserveProjectBudget(options.projectId, executesLocally, estimatedCost, now);
+
+  try {
+    // 2. Cache miss: execute provider
+    const executed = await options.run(chosenProvider);
+  if (executed.transport && executed.transport !== transport) throw new Error('AI adapter transport contract mismatch');
+  const text = executed.text;
+  let costUsd: number | null;
+  let savedUsd = 0;
+
+  if (executesLocally) {
+    costUsd = 0;
+    savedUsd = executed.actualCostUsd ?? options.actualCostUsd ?? options.estimatedCostUsd ?? 0;
+  } else {
+    const observed = executed.actualCostUsd !== undefined ? executed.actualCostUsd
+      : options.actualCostUsd !== undefined ? options.actualCostUsd
+      : options.estimatedCostUsd !== undefined ? options.estimatedCostUsd
+      : null;
+    costUsd = observed !== null && Number.isFinite(observed) ? Math.max(0, observed) : null;
+  }
+
+  recordLlmCost(options.projectId, { providerId: chosenProvider, model, costUsd, savedUsd, cached: false, local: executesLocally }, now);
+
+  const ymylCheck = options.ymyl ? validateYmylClaim(text, options.sources ?? []) : null;
+  if (ymylCheck && !ymylCheck.allowed) {
+    return blockedResult({
+      text: '', providerId: chosenProvider, model, costUsd, savedUsd, cached: false, local: executesLocally,
+      leavesDevice: willLeave, factGatePassed: false, rejectedClaims: ymylCheck.rejectedValues, needsHumanApproval: true,
+    }, ymylCheck.rejectedValues);
+  }
+  storeProjectTask(options.projectId, chosenProvider, model, options.prompt, text, costUsd, options.vector, now.getTime());
+  return {
+    text, providerId: chosenProvider, model, costUsd, savedUsd, cached: false, local: executesLocally, leavesDevice: willLeave,
+    factGatePassed: ymylCheck ? ymylCheck.allowed : true,
+    rejectedClaims: ymylCheck ? ymylCheck.rejectedValues : [],
+    needsHumanApproval: Boolean(options.ymyl),
+  };
+  } finally { releaseBudget(); }
+};
