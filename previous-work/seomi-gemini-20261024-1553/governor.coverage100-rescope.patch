+    view3.unmount();
+
+    const auditNullControls: PageAuditData = {
+      ...makeBaseAudit(),
+      accessibility: {
+        hidden_form_control_count: 5,
+        hidden_form_controls: undefined,
+        anti_spam_text_control_count: 4,
+        anti_spam_text_controls: undefined,
