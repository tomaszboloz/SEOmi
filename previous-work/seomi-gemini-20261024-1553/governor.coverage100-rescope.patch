+
+    const view1 = render(<MetadataAccessibilityHidden audit={auditTruncated} />);
+    expect(screen.getByText(/source 12:4/i)).toBeTruthy();
+    expect(screen.getAllByText(/Shown first 1/i).length).toBe(2);
