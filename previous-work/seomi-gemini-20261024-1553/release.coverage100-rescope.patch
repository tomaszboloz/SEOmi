+import { act, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import i18n from '@/i18n';
+import { CopilotPatcherPanel } from '@/components/Results/copilotPatcher';
+import type { PatchTarget } from '@/services/copilotPatcher';
+import { useProjectStore } from '@/stores/projectStore';
+import { useAuthStore } from '@/stores/authStore';
+
+const target: PatchTarget = {
+  h1: 'Blood glucose guide', h2: ['Normal values'], heading: 'What is normal?',
+  paragraph: 'Blood glucose is 90 mg/dl.', language: 'en', pageEntities: ['Blood glucose'], missingEntities: [], removeFragments: [],
+};
+
+describe('RELEASE CopilotPatcherPanel branches lines 71 and 79', () => {
+  beforeEach(async () => {
+    await i18n.changeLanguage('en');
+    useProjectStore.setState({ activeProjectId: 'ui-project' });
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('covers line 71 when providers is undefined (selectedConnected true vs false)', async () => {
+    // Branch 1: providers is undefined and selectedConnected is false -> configured is []
+    useAuthStore.setState({
+      provider: 'ollama' as never,
+      connectionStatus: { ollama: 'disconnected' } as never,
+    });
+    const { rerender } = render(<CopilotPatcherPanel target={target} projectId="ui-project" index={0} />);
+    fireEvent.click(screen.getByRole('button', { name: 'Suggest patch 1' }));
+    expect(await screen.findByText('Connect an AI provider before requesting a patch.')).toBeTruthy();
+
+    // Branch 2: providers is undefined and selectedConnected is true -> configured is [{ id, local, generate }]
+    useAuthStore.setState({
+      provider: 'ollama' as never,
+      connectionStatus: { ollama: 'connected' } as never,
+      connectionMethod: { ollama: 'local_cli' } as never,
+    });
+    rerender(<CopilotPatcherPanel target={target} projectId="ui-project" index={0} />);
+    fireEvent.click(screen.getByRole('button', { name: 'Suggest patch 1' }));
+    // Will attempt generation; since createBriefDeps has no live local CLI backend, it will fail with an error message
+    expect(await screen.findByRole('button', { name: 'Suggest patch 1' })).toBeTruthy();
+  });
+
+  it('covers line 79 result branches (provider-error vs aborted)', async () => {
+    // Branch 1: provider throws generic Error -> result.reason === 'provider-error' -> shows error
+    const failingProvider = {
+      id: 'mock-fail',
+      generate: vi.fn(async () => { throw new Error('Simulated upstream model crash'); }),
+    };
+    render(<CopilotPatcherPanel target={target} projectId="ui-project" index={0} providers={[failingProvider]} />);
+    fireEvent.click(screen.getByRole('button', { name: 'Suggest patch 1' }));
+    const alert = await screen.findByRole('alert');
+    expect(alert.textContent).toContain('Simulated upstream model crash');
+
+    // Branch 2: provider throws DOMException AbortError from within generate without aborting panel controller
+    // proposePatch returns { ok: false, reason: 'aborted' } -> line 79 else-if evaluates to false (no state update)
+    const abortingProvider = {
+      id: 'mock-abort',
+      generate: vi.fn(async () => { throw new DOMException('aborted', 'AbortError'); }),
+    };
+    const { unmount } = render(<CopilotPatcherPanel target={target} projectId="ui-project" index={1} providers={[abortingProvider]} />);
+    fireEvent.click(screen.getByRole('button', { name: 'Suggest patch 2' }));
+    await act(async () => { await new Promise((r) => setTimeout(r, 20)); });
+    expect(screen.queryByText('Patch generation failed.')).toBeNull();
+    unmount();
+  });
+});
