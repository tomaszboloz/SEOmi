+import { act, renderHook } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import i18n from '@/i18n';
+import { useHelp } from '@/components/Help/useHelp';
+import { CLOSE_DELAY_MS, OPEN_DELAY_MS, useHelpTip } from '@/components/Help/useHelpTip';
+import { useHelpStore } from '@/components/Help/helpStore';
+import { cruxCategory } from '@/components/Performance/cruxEvidence';
+
+describe('RELEASE help and performance branch coverage', () => {
+  const originalDev = import.meta.env.DEV;
+  const originalMode = import.meta.env.MODE;
+
+  afterEach(() => {
+    import.meta.env.DEV = originalDev;
+    import.meta.env.MODE = originalMode;
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+    useHelpStore.setState({ openId: null });
+  });
+
+  it('covers useHelp line 14 dev/mode warn branches and valid help resolution', () => {
+    const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
+
+    // DEV=true, MODE='development' -> logs warning for missing/incomplete key
+    import.meta.env.DEV = true;
+    import.meta.env.MODE = 'development';
+    const { result: devResult } = renderHook(() => useHelp('nonexistent-gap-key' as never));
+    expect(devResult.current).toBeNull();
+    expect(warnSpy).toHaveBeenCalledWith('[help] missing or incomplete help entry "help.nonexistent-gap-key"');
+
+    // DEV=true, MODE='test' -> suppresses warning
+    warnSpy.mockClear();
+    import.meta.env.MODE = 'test';
+    const { result: testResult } = renderHook(() => useHelp('nonexistent-gap-key' as never));
+    expect(testResult.current).toBeNull();
+    expect(warnSpy).not.toHaveBeenCalled();
+
+    // DEV=false -> suppresses warning
+    import.meta.env.DEV = false;
+    import.meta.env.MODE = 'development';
+    const { result: prodResult } = renderHook(() => useHelp('nonexistent-gap-key' as never));
+    expect(prodResult.current).toBeNull();
+    expect(warnSpy).not.toHaveBeenCalled();
+
+    // Valid help entry
+    i18n.addResource('en', 'translation', 'help.sample-gap', {
+      title: 'T', what: 'W', why: 'Y', action: 'A', example: 'E', learnMore: 'L',
+    } as never);
+    const { result: validResult } = renderHook(() => useHelp('sample-gap' as never));
+    expect(validResult.current).toEqual({
+      title: 'T', what: 'W', why: 'Y', action: 'A', example: 'E', learnMore: 'L',
+    });
+  });
+
+  it('covers useHelpTip line 54 open vs closed pointer enter branches', () => {
+    vi.useFakeTimers();
+    const { result } = renderHook(() => useHelpTip());
+    expect(result.current.open).toBe(false);
+
+    // Touch pointer type returns early
+    result.current.trigger.onPointerEnter({ pointerType: 'touch' } as never);
+    expect(useHelpStore.getState().openId).toBeNull();
+
+    // Closed: schedules timer and opens after delay
+    result.current.trigger.onPointerEnter({ pointerType: 'mouse' } as never);
+    act(() => { vi.advanceTimersByTime(OPEN_DELAY_MS); });
+    expect(useHelpStore.getState().openId).toBe(result.current.uid);
+    expect(result.current.open).toBe(true);
+
+    // Open: pointer enter branch evaluates (!open === false), does not schedule open timer
+    result.current.trigger.onPointerEnter({ pointerType: 'mouse' } as never);
+    expect(useHelpStore.getState().openId).toBe(result.current.uid);
+
+    // Pointer leave hides after delay
+    result.current.trigger.onPointerLeave({ pointerType: 'mouse' } as never);
+    act(() => { vi.advanceTimersByTime(CLOSE_DELAY_MS); });
+    expect(useHelpStore.getState().openId).toBeNull();
+  });
+
+  it('covers cruxCategory line 46 hasOwnProperty branches for thresholds', () => {
+    const t = (k: string) => k;
+
+    // Has own property: valid known metric and rating levels
+    expect(cruxCategory({ metric: 'largest_contentful_paint', percentiles: { p75: 2000 } }, t)).toBe('pageSpeedUi.crux.good');
+    expect(cruxCategory({ metric: 'largest_contentful_paint', percentiles: { p75: 3500 } }, t)).toBe('pageSpeedUi.crux.needsImprovement');
+    expect(cruxCategory({ metric: 'largest_contentful_paint', percentiles: { p75: 4500 } }, t)).toBe('pageSpeedUi.crux.poor');
+
+    // Does NOT have own property: unknown metric name -> bounds undefined -> unrated
+    expect(cruxCategory({ metric: 'unknown_metric_gap', percentiles: { p75: 100 } }, t)).toBe('pageSpeedUi.crux.unrated');
+
+    // metric is undefined -> fallback '' -> does NOT have own property -> bounds undefined -> unrated
+    expect(cruxCategory({ metric: undefined, percentiles: { p75: 100 } }, t)).toBe('pageSpeedUi.crux.unrated');
+
+    // null percentile value
+    expect(cruxCategory({ metric: 'largest_contentful_paint', percentiles: { p75: null } }, t)).toBe('pageSpeedUi.crux.unrated');
+  });
+});
