+});
+
+describe('deriveCrawlStartedAt and toIso edge cases', () => {
+  it('derives from startedAt, completedAt-duration, and handles RangeError', () => {
+    expect(deriveCrawlStartedAt({ startedAt: '2026-10-24T10:00:00Z' } as unknown as CrawlRunRecord)).toBe('2026-10-24T10:00:00.000Z');
+    expect(deriveCrawlStartedAt({ completedAt: '2026-10-24T10:05:00.000Z', result: { duration_ms: 300000 } } as unknown as CrawlRunRecord)).toBe('2026-10-24T10:00:00.000Z');
+    expect(deriveCrawlStartedAt({ startedAt: 'invalid-time' } as unknown as CrawlRunRecord)).toBeUndefined();
+    expect(deriveCrawlStartedAt({ completedAt: 'invalid-time', result: { duration_ms: 1000 } } as unknown as CrawlRunRecord)).toBeUndefined();
+    expect(deriveCrawlStartedAt({ completedAt: '2026-10-24T10:00:00Z' } as unknown as CrawlRunRecord)).toBeUndefined();
+    expect(deriveCrawlStartedAt({ completedAt: '2026-10-24T10:00:00Z', result: { duration_ms: -5 } } as unknown as CrawlRunRecord)).toBeUndefined();
