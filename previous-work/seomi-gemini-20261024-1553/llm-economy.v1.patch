@@ -0,0 +1,102 @@
+import { isLocalProvider, leavesDevice, pickBatchProvider } from './costMeter';
+import { validateYmylClaim } from './factGate';
+import { recordLlmCost, withinProjectBudget } from './llmBudget';
+import { buildTaskKey, findExactCached, putExactCached, resolveCacheSavings } from './semanticCache';
+
+export interface ExecuteOptions {
+  projectId: string;
+  configuredProviders: string[];
+  providerId?: string;
+  model?: string;
+  prompt: string;
+  batchSize?: number;
+  batchThreshold?: number;
+  estimatedCostUsd?: number;
+  actualCostUsd?: number;
+  ymyl?: boolean;
+  sources?: string[];
+  run: (providerId: string) => Promise<{ text: string; actualCostUsd?: number }>;
+  now?: Date;
+}
+
+export interface ExecutionResult {
+  text: string;
+  providerId: string;
+  model: string;
+  costUsd: number;
+  savedUsd: number;
+  cached: boolean;
+  local: boolean;
+  leavesDevice: boolean;
+  factGatePassed: boolean;
+  rejectedClaims: string[];
+  needsHumanApproval: boolean;
+}
+
+export const executeWithEconomy = async (options: ExecuteOptions): Promise<ExecutionResult> => {
+  const chosenProvider = options.providerId
+    ?? (options.batchSize !== undefined ? pickBatchProvider(options.configuredProviders, options.batchSize, options.batchThreshold) : null)
+    ?? options.configuredProviders[0]
+    ?? '';
+  if (!chosenProvider) throw new Error('No AI provider configured');
+
+  const model = options.model ?? 'default';
+  const local = isLocalProvider(chosenProvider);
+  const willLeave = leavesDevice(chosenProvider);
+  const estimatedCost = local ? 0 : Math.max(0, options.estimatedCostUsd ?? 0);
+  const now = options.now ?? new Date();
+
+  if (!withinProjectBudget(options.projectId, estimatedCost, now)) {
+    throw new Error('Project LLM budget exceeded');
+  }
+
+  const taskKey = buildTaskKey(chosenProvider, model, options.prompt);
+  const cachedHit = findExactCached(taskKey);
+
+  let text: string;
+  let costUsd: number;
+  let savedUsd: number;
+  let isCached = false;
+
+  if (cachedHit) {
+    text = cachedHit.response;
+    const savings = resolveCacheSavings(cachedHit.costUsd);
+    costUsd = savings.costUsd;
+    savedUsd = savings.savedUsd;
+    isCached = true;
+    recordLlmCost(options.projectId, { providerId: chosenProvider, model, costUsd: 0, savedUsd, cached: true, local }, now);
+  } else {
+    const executed = await options.run(chosenProvider);
+    text = executed.text;
+    const rawCost = Math.max(0, executed.actualCostUsd ?? options.actualCostUsd ?? options.estimatedCostUsd ?? 0);
+    costUsd = local ? 0 : rawCost;
+    savedUsd = local ? rawCost : 0;
+    putExactCached(taskKey, text, rawCost, now.getTime());
+    recordLlmCost(options.projectId, { providerId: chosenProvider, model, costUsd, savedUsd, cached: false, local }, now);
+  }
+
+  let factGatePassed = true;
+  let rejectedClaims: string[] = [];
+  let needsHumanApproval = false;
+
+  if (options.ymyl) {
+    const ymylCheck = validateYmylClaim(text, options.sources ?? []);
+    factGatePassed = ymylCheck.allowed;
+    rejectedClaims = ymylCheck.rejectedValues;
+    needsHumanApproval = true;
+  }
+
+  return {
+    text,
+    providerId: chosenProvider,
+    model,
+    costUsd,
+    savedUsd,
+    cached: isCached,
+    local,
+    leavesDevice: willLeave,
+    factGatePassed,
+    rejectedClaims,
+    needsHumanApproval,
+  };
+};
