@@ -0,0 +1,73 @@
+import { CrawlEventLog, type CrawlEvent, type EventSink, type Reducer } from './eventLog';
+import { persistCrawlEvents } from './sqliteEventSink';
+
+/**
+ * A CrawlEventLog bound to a specific project and run that flushes appended
+ * events down to SQLite storage in strict sequence order.
+ */
+export class PersistentCrawlEventLog {
+  readonly projectId: string;
+  readonly runId: string;
+  private readonly inner: CrawlEventLog;
+  private pending: CrawlEvent[] = [];
+  private currentFlush: Promise<void> | null = null;
+
+  constructor(projectId: string, runId: string, initial: CrawlEvent[] = []) {
+    this.projectId = projectId;
+    this.runId = runId;
+    this.inner = new CrawlEventLog(initial);
+  }
+
+  get revision(): number {
+    return this.inner.revision;
+  }
+
+  allEvents(): readonly CrawlEvent[] {
+    return this.inner.allEvents();
+  }
+
+  append<P>(type: string, payload: P, now: () => Date = () => new Date()): CrawlEvent<P> {
+    const event = this.inner.append(type, payload, now);
+    this.pending.push(event);
+    void this.scheduleFlush().catch(() => {});
+    return event;
+  }
+
+  subscribe(sink: EventSink): () => void {
+    return this.inner.subscribe(sink);
+  }
+
+  project<S>(reducer: Reducer<S>, initial: () => S, upTo?: number): S {
+    return this.inner.project(reducer, initial, upTo);
+  }
+
+  private scheduleFlush(): Promise<void> {
+    if (this.currentFlush) return this.currentFlush;
+    this.currentFlush = (async () => {
+      while (this.pending.length > 0) {
+        const batch = [...this.pending];
+        this.pending = [];
+        try {
+          await persistCrawlEvents(this.projectId, this.runId, batch);
+        } catch (err) {
+          this.pending.unshift(...batch);
+          throw err;
+        }
+      }
+    })().finally(() => {
+      this.currentFlush = null;
+    });
+    return this.currentFlush;
+  }
+
+  /** Waits for all in-flight persistence writes to commit. */
+  async flush(): Promise<void> {
+    while (this.pending.length > 0 || this.currentFlush) {
+      if (this.currentFlush) {
+        await this.currentFlush;
+      } else {
+        await this.scheduleFlush();
+      }
+    }
+  }
+}

diff --git a/src/services/snapshots/replay.ts b/src/services/snapshots/replay.ts
new file mode 100644
index 00000000..6da72385
--- /dev/null
+++ b/src/services/snapshots/replay.ts
@@ -0,0 +1,127 @@
+import { CrawlEventLog, type CrawlEvent } from './eventLog';
+import { fetchCrawlEvents, persistCrawlEvents } from './sqliteEventSink';
+import { listStoredRuns, loadStoredRun } from '@/services/crawlStore';
+import type { CrawlRunRecord } from '@/types';
+
+export type EventProvenance = 'checkpoint-derived' | 'live-crawl';
+
+export const buildSyntheticEventsFromRun = (
+  run: CrawlRunRecord,
+  provenance: EventProvenance = 'checkpoint-derived',
+): CrawlEvent[] => {
+  const startedAt = run.startedAt ?? run.completedAt;
+  const events: CrawlEvent[] = [];
+  events.push({
+    seq: 1,
+    type: 'crawl:started',
+    at: startedAt,
+    payload: { id: run.id, startUrl: run.startUrl, startedAt, provenance },
+  });
+  const pages = run.result?.pages ?? [];
+  pages.forEach((page, index) => {
+    events.push({
+      seq: index + 2,
+      type: 'crawl:page',
+      at: run.completedAt,
+      payload: { ...page, provenance },
+    });
+  });
+  events.push({
+    seq: pages.length + 2,
+    type: 'crawl:completed',
+    at: run.completedAt,
+    payload: {
+      id: run.id,
+      completedAt: run.completedAt,
+      pageCount: pages.length,
+      startUrl: run.startUrl,
+      provenance,
+    },
+  });
+  return events;
+};
+
+/** Paginates sequentially through all events in SQLite until complete. */
+export const fetchAllCrawlEvents = async (
+  projectId: string,
+  runId: string,
+  batchSize = 10_000,
+): Promise<CrawlEvent[]> => {
+  const all: CrawlEvent[] = [];
+  let fromSeq = 1;
+  let effectiveRunId = runId;
+  while (true) {
+    const batch = await fetchCrawlEvents(projectId, effectiveRunId, fromSeq, batchSize);
+    if (!batch.length) break;
+    if (!effectiveRunId && batch[0].runId) {
+      effectiveRunId = batch[0].runId;
+    }
+    all.push(...batch);
+    if (batch.length < batchSize) break;
+    fromSeq = batch[batch.length - 1].seq + 1;
+  }
+  return all;
+};
+
+const assertContiguousEvents = (projectId: string, runId: string, events: readonly CrawlEvent[]): void => {
+  for (let i = 0; i < events.length; i++) {
+    if (events[i].seq !== i + 1) {
+      throw new Error(
+        `Corrupted crawl event sequence for project ${projectId} run ${runId}: expected seq ${i + 1}, got ${events[i].seq}`,
+      );
+    }
+  }
+};
+
+export const replayCrawlEvents = async (
+  projectId: string,
+  runId: string,
+): Promise<CrawlEventLog> => {
+  const existing = await fetchAllCrawlEvents(projectId, runId);
+  if (existing.length > 0) {
+    assertContiguousEvents(projectId, runId, existing);
+    return new CrawlEventLog(existing);
+  }
+  const legacyRun = await loadStoredRun(projectId, runId);
+  if (!legacyRun) return new CrawlEventLog();
+
+  const synthetic = buildSyntheticEventsFromRun(legacyRun, 'checkpoint-derived');
+  await persistCrawlEvents(projectId, runId, synthetic);
+  return new CrawlEventLog(synthetic);
+};
+
+export const replayLatestRunEvents = async (
+  projectId: string,
+): Promise<{ runId: string | null; log: CrawlEventLog }> => {
+  const [summaries, inFlight] = await Promise.all([
+    listStoredRuns(projectId),
+    fetchAllCrawlEvents(projectId, ''),
+  ]);
+
+  const p0 = inFlight[0]?.payload as Record<string, unknown> | undefined;
+  const inFlightRunId = inFlight[0]?.runId
+    ?? (p0?.id !== undefined && p0?.id !== null ? String(p0.id) : null)
+    ?? (p0?.runId !== undefined && p0?.runId !== null ? String(p0.runId) : null)
+    ?? (inFlight.length > 0 ? 'in-flight-run' : null);
+
+  const inFlightLast = inFlight[inFlight.length - 1];
+  const inFlightAt = inFlightLast?.at ? new Date(inFlightLast.at).getTime() : 0;
+  const latestSummary = summaries[0];
+  const summaryAt = latestSummary
+    ? new Date((latestSummary as { completedAt?: string; startedAt?: string }).startedAt || latestSummary.completedAt || 0).getTime()
+    : 0;
+
+  if (inFlight.length > 0 && inFlightRunId) {
+    if (!latestSummary || inFlightAt >= summaryAt || inFlightRunId !== latestSummary.id) {
+      assertContiguousEvents(projectId, inFlightRunId, inFlight);
+      return { runId: inFlightRunId, log: new CrawlEventLog(inFlight) };
+    }
+  }
+
+  if (latestSummary) {
+    const log = await replayCrawlEvents(projectId, latestSummary.id);
+    return { runId: latestSummary.id, log };
+  }
+
+  return { runId: null, log: new CrawlEventLog() };
+};

diff --git a/src/services/snapshots/sqliteEventSink.ts b/src/services/snapshots/sqliteEventSink.ts
new file mode 100644
index 00000000..c49cab43
--- /dev/null
+++ b/src/services/snapshots/sqliteEventSink.ts
@@ -0,0 +1,73 @@
+import { invokeTauriCommand, isTauriEnvironment } from '@/services/tauri';
+import type { CrawlEvent } from './eventLog';
+
+export interface StoredCrawlEventWire {
+  projectId: string;
+  runId: string;
+  seq: number;
+  eventType: string;
+  at: string;
+  payload: unknown;
+}
+
+const mapWireToEvent = (raw: StoredCrawlEventWire): CrawlEvent => ({
+  seq: raw.seq,
+  type: raw.eventType,
+  at: raw.at,
+  payload: raw.payload as any,
+  runId: raw.runId,
+  projectId: raw.projectId,
+});
+
+const mapEventToWire = (
+  projectId: string,
+  runId: string,
+  event: CrawlEvent,
+): StoredCrawlEventWire => ({
+  projectId: event.projectId ?? projectId,
+  runId: event.runId ?? runId,
+  seq: event.seq,
+  eventType: event.type,
+  at: event.at,
+  payload: event.payload,
+});
+
+/** Persists an ordered sequence of events to SQLite atomically. */
+export const persistCrawlEvents = async (
+  projectId: string,
+  runId: string,
+  events: CrawlEvent[],
+): Promise<number> => {
+  if (!events.length) return 0;
+  if (!isTauriEnvironment()) {
+    throw new Error('Durable SQLite event persistence requires Tauri environment.');
+  }
+  const wire = events.map((ev) => mapEventToWire(projectId, runId, ev));
+  return invokeTauriCommand<number>('store_append_crawl_events', {
+    projectId,
+    runId,
+    events: wire,
+  });
+};
+
+/** Loads ordered events from SQLite starting from seq. */
+export const fetchCrawlEvents = async (
+  projectId: string,
+  runId: string,
+  fromSeq = 1,
+  limit = 10_000,
+): Promise<CrawlEvent[]> => {
+  if (!isTauriEnvironment()) {
+    throw new Error('SQLite event reading requires Tauri environment.');
+  }
+  const rows = await invokeTauriCommand<StoredCrawlEventWire[]>('store_load_crawl_events', {
+    projectId,
+    runId,
+    fromSeq,
+    limit,
+  });
+  if (!Array.isArray(rows)) {
+    throw new Error(`Failed to load crawl events for run ${runId}: invalid response.`);
+  }
+  return rows.map(mapWireToEvent);
+};

