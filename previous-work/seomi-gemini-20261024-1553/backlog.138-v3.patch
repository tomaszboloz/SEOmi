+++ b/tests/crawlEventLogPagination.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it, vi, beforeEach } from 'vitest';
+import { PersistentCrawlEventLog, replayCrawlEvents, replayLatestRunEvents } from '../src/services/snapshots';
+import * as sinkModule from '../src/services/snapshots/sqliteEventSink';
+import * as storeModule from '../src/services/crawlStore';
+import type { CrawlEvent } from '../src/services/snapshots/eventLog';
+
+vi.mock('../src/services/snapshots/sqliteEventSink', () => ({
+  fetchCrawlEvents: vi.fn(),
+  persistCrawlEvents: vi.fn(),
+}));
+
+vi.mock('../src/services/crawlStore', () => ({
+  listStoredRuns: vi.fn(),
+  loadStoredRun: vi.fn(),
+}));
+
+describe('Issue #138: Boundary conditions, Pagination >10k and Queue Recovery', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('drains queue on second append/flush after first storage failure without permanent rejection', async () => {
+    let writes = 0;
+    vi.mocked(sinkModule.persistCrawlEvents).mockImplementation(async () => {
+      writes++;
+      if (writes === 1) throw new Error('fixture disk full');
+      return 2;
+    });
+
+    const log = new PersistentCrawlEventLog('p', 'r');
+    log.append('crawl:started', { url: 'https://site.test' });
+
+    let firstError: string | undefined;
+    try {
+      await log.flush();
+    } catch (e) {
+      firstError = String(e);
+    }
+    expect(firstError).toContain('fixture disk full');
+
+    log.append('crawl:page', { url: 'https://site.test/a' });
+    let secondError: string | undefined;
+    try {
+      await log.flush();
+    } catch (e) {
+      secondError = String(e);
+    }
+
+    expect(secondError).toBeUndefined();
+    expect(writes).toBe(2);
+    expect(log.allEvents()).toHaveLength(2);
+  });
+
+  it('paginates over 10,000 events without silent truncation', async () => {
+    const total = 10002;
+    const events: CrawlEvent[] = Array.from({ length: total }, (_, i) => ({
+      seq: i + 1,
+      type: i === 0 ? 'crawl:started' : i === total - 1 ? 'crawl:completed' : 'crawl:page',
+      at: '2026-10-24T10:00:00.000Z',
+      payload: { id: i },
+    }));
+
+    let fetches = 0;
+    vi.mocked(sinkModule.fetchCrawlEvents).mockImplementation(async (_p, _r, from = 1, limit = 10000) => {
+      fetches++;
+      return events.slice(from - 1, from - 1 + limit);
+    });
+
+    const log = await replayCrawlEvents('p', 'r');
+    expect(log.allEvents()).toHaveLength(10002);
+    expect(fetches).toBe(2);
+    expect(log.allEvents()[total - 1].type).toBe('crawl:completed');
+  });
+
+  it('discovers in-flight run from durable events when completed run snapshot is missing', async () => {
+    vi.mocked(storeModule.listStoredRuns).mockResolvedValueOnce([]);
+    const events: CrawlEvent[] = [
+      { seq: 1, type: 'crawl:started', at: '2026-10-24T10:00:00Z', payload: { id: 'in-flight-99', startUrl: 'https://inf.test' } },
+      { seq: 2, type: 'crawl:page', at: '2026-10-24T10:00:01Z', payload: { url: 'https://inf.test/p1' } },
+    ];
+    vi.mocked(sinkModule.fetchCrawlEvents).mockResolvedValueOnce(events);
+
+    const restored = await replayLatestRunEvents('p');
+    expect(restored.runId).toBe('in-flight-99');
+    expect(restored.log.allEvents()).toHaveLength(2);
+  });
+});

diff --git a/tests/crawlEventLogRestart.test.ts b/tests/crawlEventLogRestart.test.ts
new file mode 100644
index 00000000..816b9435
--- /dev/null
+++ b/tests/crawlEventLogRestart.test.ts
@@ -0,0 +1,107 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { loadCrawlRuns, saveCrawlRuns } from '../src/services/crawlPersistence';
+import { replayLatestRunEvents } from '../src/services/snapshots';
+import { createCrawlRunFixture } from './fixtures/crawl';
+
+const native = vi.hoisted(() => ({
+  invokeTauriCommand: vi.fn(),
+  isTauriEnvironment: () => true,
+}));
+vi.mock('../src/services/tauri', () => native);
+
+describe('Issue #138: EventLog Restart, Replay & IPC Wiring', () => {
+  beforeEach(() => {
+    native.invokeTauriCommand.mockReset();
+    localStorage.clear();
+  });
+  afterEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('saveCrawlRuns appends live events to SQLite via IPC and throws on DB failure', async () => {
+    const run = createCrawlRunFixture({ id: 'run-desktop-1' });
+    native.invokeTauriCommand.mockImplementation(async (cmd: string) => {
+      if (cmd === 'load_project_crawl_runs') return [];
+      if (cmd === 'store_load_crawl_events') return [];
+      if (cmd === 'store_append_crawl_events') return 2;
+      if (cmd === 'store_replace_crawl_runs') return undefined;
+      return undefined;
+    });
+
+    const result = await saveCrawlRuns('proj-live', [run]);
+    expect(result).toEqual({ prunedRuns: 0 });
+    expect(native.invokeTauriCommand).toHaveBeenCalledWith(
+      'store_append_crawl_events',
+      expect.objectContaining({
+        projectId: 'proj-live',
+        runId: 'run-desktop-1',
+        events: expect.arrayContaining([
+          expect.objectContaining({ eventType: 'crawl:started' }),
+        ]),
+      }),
+    );
+
+    // DB failure on event append must throw and NOT be swallowed
+    native.invokeTauriCommand.mockImplementation(async (cmd: string) => {
+      if (cmd === 'load_project_crawl_runs') return [];
+      if (cmd === 'store_load_crawl_events') return [];
+      if (cmd === 'store_append_crawl_events') throw new Error('SQLite disk full');
+      return undefined;
+    });
+    await expect(saveCrawlRuns('proj-live', [run])).rejects.toThrow('SQLite disk full');
+  });
+
+  it('restart replay reconstructs projection and isolates projects', async () => {
+    const runA = createCrawlRunFixture({ id: 'run-a' });
+    const runB = createCrawlRunFixture({ id: 'run-b' });
+
+    native.invokeTauriCommand.mockImplementation(async (cmd: string, args: any) => {
+      if (cmd === 'load_project_crawl_runs') return [];
+      if (cmd === 'store_list_crawl_runs') {
+        if (args?.projectId === 'proj-A') {
+          return [{ id: 'run-a', completedAt: '2026', startUrl: 'https://a.test', pageCount: 0 }];
+        }
+        return [{ id: 'run-b', completedAt: '2026', startUrl: 'https://b.test', pageCount: 0 }];
+      }
+      if (cmd === 'store_load_crawl_run') return args?.projectId === 'proj-A' ? runA : runB;
+      if (cmd === 'store_load_crawl_events') {
+        if (args?.projectId === 'proj-A') {
+          return [{
+            projectId: 'proj-A', runId: 'run-a', seq: 1, eventType: 'crawl:started',
+            at: '2026', payload: { domain: 'a.test' },
+          }];
+        }
+        return [{
+          projectId: 'proj-B', runId: 'run-b', seq: 1, eventType: 'crawl:started',
+          at: '2026', payload: { domain: 'b.test' },
+        }];
+      }
+      return undefined;
+    });
+
+    const runsA = await loadCrawlRuns('proj-A');
+    expect(runsA[0].id).toBe('run-a');
+
+    const latestA = await replayLatestRunEvents('proj-A');
+    expect(latestA.runId).toBe('run-a');
+    expect(latestA.log.allEvents()[0].payload).toEqual({ domain: 'a.test' });
+
+    const latestB = await replayLatestRunEvents('proj-B');
+    expect(latestB.runId).toBe('run-b');
+    expect(latestB.log.allEvents()[0].payload).toEqual({ domain: 'b.test' });
+  });
+
+  it('detects and rejects conflicting payloads on replay or re-save', async () => {
+    const run = createCrawlRunFixture({ id: 'run-conflict' });
+    native.invokeTauriCommand.mockImplementation(async (cmd: string) => {
+      if (cmd === 'load_project_crawl_runs') return [];
+      if (cmd === 'store_load_crawl_events') return [];
+      if (cmd === 'store_append_crawl_events') {
+        throw new Error('Sequence conflict at seq 1: distinct data.');
+      }
+      return undefined;
+    });
+
+    await expect(saveCrawlRuns('p-err', [run])).rejects.toThrow('Sequence conflict');
+  });
+});

diff --git a/tests/crawlEventLogSqlite.test.ts b/tests/crawlEventLogSqlite.test.ts
new file mode 100644
index 00000000..719201cd
--- /dev/null
+++ b/tests/crawlEventLogSqlite.test.ts
@@ -0,0 +1,124 @@
+import { describe, expect, it, vi, beforeEach } from 'vitest';
+import {
+  CrawlEventLog,
+  PersistentCrawlEventLog,
+  openSimulationSession,
+  persistCrawlEvents,
+  replayCrawlEvents,
+} from '@/services/snapshots';
+import * as tauriModule from '@/services/tauri';
+import * as crawlStoreModule from '@/services/crawlStore';
+import type { CrawlRunRecord } from '@/types';
+
+vi.mock('@/services/tauri', () => ({
+  isTauriEnvironment: vi.fn(),
+  invokeTauriCommand: vi.fn(),
+}));
+
+vi.mock('@/services/crawlStore', () => ({
+  listStoredRuns: vi.fn(),
+  loadStoredRun: vi.fn(),
+}));
+
+describe('Issue #138: SQLite Append-Only Crawl Event Log & Replay', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('rejects persistence when not in Tauri environment and surfaces IPC failure', async () => {
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(false);
+    await expect(persistCrawlEvents('p1', 'r1', [{ seq: 1, type: 'init', at: '2026', payload: {} }]))
+      .rejects.toThrow('Durable SQLite event persistence requires Tauri environment');
+
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(true);
+    vi.mocked(tauriModule.invokeTauriCommand).mockRejectedValueOnce(new Error('Disk I/O error'));
+    await expect(persistCrawlEvents('p1', 'r1', [{ seq: 1, type: 'init', at: '2026', payload: {} }]))
+      .rejects.toThrow('Disk I/O error');
+  });
+
+  it('persistent log flushes ordered batch to SQLite and retains pending on failure for rollback', async () => {
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(true);
+    const invokeSpy = vi.mocked(tauriModule.invokeTauriCommand).mockResolvedValue(1);
+
+    const log = new PersistentCrawlEventLog('proj-A', 'run-1');
+    log.append('crawl:started', { url: 'https://test.io' });
+    await log.flush();
+
+    expect(invokeSpy).toHaveBeenCalledWith('store_append_crawl_events', expect.objectContaining({
+      projectId: 'proj-A',
+      runId: 'run-1',
+      events: [expect.objectContaining({ seq: 1, eventType: 'crawl:started' })],
+    }));
+
+    invokeSpy.mockRejectedValueOnce(new Error('Storage busy'));
+    log.append('crawl:page', { url: 'https://test.io/1' });
+    await expect(log.flush()).rejects.toThrow('Storage busy');
+    // Events retained in log
+    expect(log.allEvents()).toHaveLength(2);
+  });
+
+  it('replays stored events into a fresh event log with project/run isolation', async () => {
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(true);
+    vi.mocked(tauriModule.invokeTauriCommand).mockResolvedValueOnce([
+      { projectId: 'proj-A', runId: 'run-1', seq: 1, eventType: 'crawl:started', at: '2026', payload: { start: true } },
+      { projectId: 'proj-A', runId: 'run-1', seq: 2, eventType: 'crawl:page', at: '2026', payload: { url: '/a' } },
+    ]);
+
+    const log = await replayCrawlEvents('proj-A', 'run-1');
+    expect(log.revision).toBe(2);
+    expect(log.allEvents()[1].payload).toEqual({ url: '/a' });
+  });
+
+  it('migrates legacy crawl run into synthetic SQLite events when no prior log exists', async () => {
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(true);
+    vi.mocked(tauriModule.invokeTauriCommand).mockResolvedValueOnce([]); // No existing events
+    const legacy: CrawlRunRecord = {
+      id: 'legacy-run-99',
+      startUrl: 'https://legacy.test',
+      completedAt: '2026-10-24T10:00:00Z',
+      config: {} as any,
+      result: { pages: [{ url: 'https://legacy.test/p1' } as any] } as any,
+    };
+    vi.mocked(crawlStoreModule.loadStoredRun).mockResolvedValueOnce(legacy);
+
+    const log = await replayCrawlEvents('proj-legacy', 'legacy-run-99');
+    expect(log.revision).toBe(3); // started, page 1, completed
+    expect(log.allEvents()[0].type).toBe('crawl:started');
+    expect(log.allEvents()[1].type).toBe('crawl:page');
+    expect(log.allEvents()[2].type).toBe('crawl:completed');
+  });
+
+  it('10k concurrent page capture does not mutate open WhatIf snapshot and marks session stale', () => {
+    const log = new CrawlEventLog();
+    log.append('page', { id: 'p0', score: 10 });
+
+    type State = { pages: string[]; totalScore: number };
+    const reducer = (state: State, ev: any): State => ({
+      pages: [...state.pages, ev.payload.id],
+      totalScore: state.totalScore + (ev.payload.score ?? 0),
+    });
+    const initial = (): State => ({ pages: [], totalScore: 0 });
+
+    const session = openSimulationSession(log, reducer, initial);
+    expect(session.snapshot).toEqual({ pages: ['p0'], totalScore: 10 });
+    expect(session.isStale()).toBe(false);
+
+    // Simulate 10,000 concurrent page events incoming in background crawl
+    for (let i = 1; i <= 10_000; i++) {
+      log.append('page', { id: `p${i}`, score: 1 });
+    }
+
+    // Open WhatIf snapshot is strictly immutable and unchanged
+    expect(session.snapshot).toEqual({ pages: ['p0'], totalScore: 10 });
+    expect(session.isStale()).toBe(true);
+    expect(Object.isFrozen(session.snapshot)).toBe(true);
+
+    // Refresh produces a detached updated snapshot
+    const refreshed = session.refresh();
+    expect(refreshed.isStale()).toBe(false);
+    expect(refreshed.snapshot.pages.length).toBe(10_001);
+    expect(refreshed.snapshot.totalScore).toBe(10 + 10_000);
+    // Old session remains untouched
+    expect(session.snapshot.pages.length).toBe(1);
+  });
+});

diff --git a/tests/crawlExecutionLiveHook.test.ts b/tests/crawlExecutionLiveHook.test.ts
new file mode 100644
index 00000000..c710aea7
--- /dev/null
+++ b/tests/crawlExecutionLiveHook.test.ts
@@ -0,0 +1,107 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createCrawlExecutionActions } from '@/stores/tools/crawl/execution';
+import { LiveCrawlEventHook } from '@/stores/tools/crawl/executionHook';
+import { PersistentCrawlEventLog } from '@/services/snapshots';
+import { useProjectStore } from '@/stores/projectStore';
+import { useSettingsStore } from '@/stores/settingsStore';
+import * as tauriModule from '@/services/tauri';
+import { isolatedToolsSlice } from './fixtures/toolsSlice';
+import { createCrawlPageFixture, createCrawlResultFixture } from './fixtures/crawl';
+
+vi.mock('@/services/tauri', () => ({
+  isTauriEnvironment: vi.fn(),
+  invokeTauriCommand: vi.fn(),
+}));
+
+const P = 'proj-live-hook';
+const U = 'https://site.test/';
+
+describe('Issue #138 Live In-flight Event Streaming Hook in Crawl Execution', () => {
+  const originalSettings = useSettingsStore.getState();
+  const capturedWireBatches: Array<{ projectId: string; runId: string; events: unknown[] }> = [];
+
+  beforeEach(() => {
+    localStorage.clear();
+    capturedWireBatches.length = 0;
+    useProjectStore.setState({ activeProjectId: P });
+    vi.mocked(tauriModule.isTauriEnvironment).mockReturnValue(true);
+    vi.mocked(tauriModule.invokeTauriCommand).mockImplementation(async (cmd, args) => {
+      if (cmd === 'store_append_crawl_events') {
+        const payload = args as { projectId: string; runId: string; events: unknown[] };
+        capturedWireBatches.push(payload);
+        return payload.events.length;
+      }
+      return null;
+    });
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    useSettingsStore.setState(originalSettings);
+  });
+
+  it('does not create duplicate frontend writer to SQLite during desktop crawl', async () => {
+    const page = createCrawlPageFixture({ url: U, final_url: U, http_status: 200 });
+    const result = createCrawlResultFixture({ start_url: U, pages_crawled: 1, pages: [page] });
+    const invoke = vi.fn().mockResolvedValue(result);
+    const saveCrawlRuns = vi.fn().mockResolvedValue({ prunedRuns: 0 });
+    const { actions } = isolatedToolsSlice(
+      (set, get, services) => createCrawlExecutionActions(set, get, services),
+      { invoke, saveCrawlRuns },
+    );
+
+    const out = await actions.startSiteCrawl(U, 1);
+    expect(out).toEqual(result);
+    // Native collector is the sole authoritative writer; frontend emits no duplicate events
+    expect(capturedWireBatches).toHaveLength(0);
+  });
+
+  it('surfaces runtime failure and sets error state when crawler fails', async () => {
+    const invoke = vi.fn().mockRejectedValue(new Error('Network unreachable'));
+    const { actions, store } = isolatedToolsSlice(
+      (set, get, services) => createCrawlExecutionActions(set, get, services),
+      { invoke },
+    );
+
+    const out = await actions.startSiteCrawl(U, 1);
+    expect(out).toBeNull();
+    expect(store.getState().crawlError).toContain('Network unreachable');
+    expect(capturedWireBatches).toHaveLength(0);
+  });
+
+  it('LiveCrawlEventHook streams started, progress, page and completed when given an event log', async () => {
+    const log = new PersistentCrawlEventLog(P, 'run-direct');
+    const hook = new LiveCrawlEventHook(P, 'run-direct', log);
+    hook.appendStarted(U);
+    hook.appendProgress({ runId: 'run-direct', discovered: 2, completed: 1, queued: 1, cancelled: false, paused: false, elapsedMs: 50, pagesPerSecond: 20 });
+    hook.appendPages([createCrawlPageFixture({ url: U })]);
+    await hook.appendCompleted(1, '2026-10-24T12:00:00Z', U);
+
+    expect(hook.eventLog?.allEvents()).toHaveLength(4);
+    expect(hook.eventLog?.allEvents().map((e) => e.type)).toEqual(['crawl:started', 'crawl:progress', 'crawl:page', 'crawl:completed']);
+    const flatEvents = capturedWireBatches.flatMap((b) => b.events) as Array<{ eventType: string }>;
+    expect(flatEvents).toHaveLength(4);
+  });
+
+  it('LiveCrawlEventHook streams cancelled and error events when given an event log', async () => {
+    const log1 = new PersistentCrawlEventLog(P, 'run-cancelled');
+    const hook1 = new LiveCrawlEventHook(P, 'run-cancelled', log1);
+    hook1.appendStarted(U);
+    await hook1.appendCancelled(0, U);
+    expect(log1.allEvents().map((e) => e.type)).toEqual(['crawl:started', 'crawl:cancelled']);
+
+    const log2 = new PersistentCrawlEventLog(P, 'run-error');
+    const hook2 = new LiveCrawlEventHook(P, 'run-error', log2);
+    hook2.appendStarted(U);
+    await hook2.appendError('Network unreachable');
+    expect(log2.allEvents().map((e) => e.type)).toEqual(['crawl:started', 'crawl:error']);
+  });
+
+  it('bounds events to originating project and run in PersistentCrawlEventLog', async () => {
+    const log = new PersistentCrawlEventLog(P, 'run-bound');
+    const hook = new LiveCrawlEventHook(P, 'run-bound', log);
+    hook.appendStarted(U);
+    await hook.flush();
+    expect(capturedWireBatches.every((b) => b.projectId === P && b.runId === 'run-bound')).toBe(true);
+  });
+});
