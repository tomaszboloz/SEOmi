+
+    let builder =
+        crate::services::http_client::resolver::public_client_builder_with_lookup(|_| async {
+            Err(std::io::Error::new(
+                std::io::ErrorKind::ConnectionRefused,
+                "transport connection refused",
+            ))
+        });
+    let mut input = request();
