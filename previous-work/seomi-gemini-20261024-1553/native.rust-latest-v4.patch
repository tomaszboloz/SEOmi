+    input
+        .headers
+        .insert("Accept".into(), "application/json".into());
+    input.body = Some("{\"patch\": true}".into());
+    let err = cms_patch_request_with_builder(input, builder)
+        .await
+        .unwrap_err();
+    assert_eq!(err, "CMS request failed");
+}
