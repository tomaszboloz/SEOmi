+import { describe, expect, it } from 'vitest';
+import { extractFeatures, parseFeatures } from '@/services/sija/features';
+
+describe('geminiGapBACKLOG: sija features schema and context branches', () => {
+  it('covers microdata itemtype branches on line 38 and authority parsing on line 13', () => {
+    // Microdata with matching LocalBusiness schema
+    const htmlMatching = '<div itemtype="https://schema.org/LocalBusiness">Store</div>';
+    expect(parseFeatures(htmlMatching).localSignals).toBeGreaterThanOrEqual(1);
+
+    // Microdata with non-matching and empty itemtype
+    const htmlNonMatching = '<div itemtype="https://schema.org/Other">Other</div><div itemtype="">Empty</div>';
+    expect(parseFeatures(htmlNonMatching).localSignals).toBe(0);
+
+    // Value without // authority start < 0
+    const htmlNoSlash = '<div itemtype="mailto:contact@schema.org">Mail</div>';
+    expect(parseFeatures(htmlNoSlash).localSignals).toBe(0);
+
+    // Document with null getAttribute for line 38 ?? branch
+    const doc = new DOMParser().parseFromString('<div itemtype="">NullItemType</div>', 'text/html');
+    const el = doc.querySelector('div')!;
+    Object.defineProperty(el, 'getAttribute', { value: () => null });
+    expect(extractFeatures(doc).localSignals).toBe(0);
+  });
+
+  it('covers context arrays, objects, query params and hashes on lines 29, 30, 33', () => {
+    // Array @context (line 29)
+    const jsonLdArrayContext = JSON.stringify({
+      '@context': ['https://schema.org', { '@language': 'en' }],
+      '@type': 'LocalBusiness',
+    });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdArrayContext}</script>`).localSignals).toBeGreaterThanOrEqual(1);
+
+    // Object @context (line 30)
+    const jsonLdObjectContext = JSON.stringify({
+      '@context': { '@vocab': 'https://schema.org/' },
+      '@type': 'LocalBusiness',
+    });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdObjectContext}</script>`).localSignals).toBeGreaterThanOrEqual(1);
+
+    // Context with search, hash, or non-root path (line 33)
+    const jsonLdSearch = JSON.stringify({ '@context': 'https://schema.org/?q=1', '@type': 'LocalBusiness' });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdSearch}</script>`).localSignals).toBe(0);
+
+    const jsonLdHash = JSON.stringify({ '@context': 'https://schema.org/#tag', '@type': 'LocalBusiness' });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdHash}</script>`).localSignals).toBe(0);
+
+    const jsonLdPath = JSON.stringify({ '@context': 'https://schema.org/SubPath', '@type': 'LocalBusiness' });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdPath}</script>`).localSignals).toBe(0);
+  });
+
+  it('covers JSON-LD arrays, raw type arrays, and parsing errors on lines 40, 44, 49', () => {
+    // Array value in hasJsonType (line 40)
+    const jsonLdArray = JSON.stringify([
+      { '@context': 'https://schema.org', '@type': ['LocalBusiness', 'Store'] },
+    ]);
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdArray}</script>`).localSignals).toBeGreaterThanOrEqual(1);
+
+    // String @type
+    const jsonLdString = JSON.stringify({
+      '@context': 'https://schema.org',
+      '@type': 'PostalAddress',
+    });
+    expect(parseFeatures(`<script type="application/ld+json">${jsonLdString}</script>`).localSignals).toBeGreaterThanOrEqual(1);
+
+    // Malformed JSON inside script (line 49 catch block)
+    const htmlMalformed = '<script type="application/ld+json">{ invalid json</script>';
+    expect(parseFeatures(htmlMalformed).localSignals).toBe(0);
+
+    // Document with null script textContent for line 49 ?? branch
+    const doc = new DOMParser().parseFromString('<script type="application/ld+json"></script>', 'text/html');
+    const script = doc.querySelector('script')!;
+    Object.defineProperty(script, 'textContent', { value: null });
+    expect(extractFeatures(doc).localSignals).toBe(0);
+  });
+});
