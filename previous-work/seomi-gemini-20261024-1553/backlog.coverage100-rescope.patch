+import { describe, expect, it } from 'vitest';
+import { templateInformationGain } from '@/services/templateGovernor/informationGain';
+import type { TemplateCluster } from '@/services/templateGovernor/cluster';
+import { contentDecay } from '@/services/topicalAuthorityMonitoring/alerts';
+import { buildTopicalBenchmark } from '@/services/topicalAuthorityReference/benchmark';
+import { buildTopics } from '@/services/topicalDiagnosis/topics';
+import type { DiagnosisDocument } from '@/services/topicalDiagnosis/types';
+import { buildAuthorityReport, type CompetitorPages } from '@/services/topicalAuthority';
+import { NOW, OWN_HOST, ownReport, ownSite, referenceTaxonomy } from './authorityFixtures';
+
+describe('geminiGapBACKLOG: templateGovernor, alerts, benchmark, and topics', () => {
+  it('covers templateInformationGain branch on line 38', () => {
+    const cluster: TemplateCluster = {
+      pattern: '/products/*',
+      pages: [
+        { url: 'https://site.test/p1', text: 'common template text uniqueA' },
+        { url: 'https://site.test/p2', text: 'common template text uniqueB' },
+      ],
+    };
+    const gain = templateInformationGain(cluster, 0.8);
+    expect(gain).toBeGreaterThan(0);
+    expect(gain).toBeLessThan(1);
+  });
+
+  it('covers contentDecay pillarUrl ternary branch on line 27', () => {
+    const report = {
+      silo: {
+        audits: {
+          withPillar: { pillarUrl: 'https://site.test/pillar' },
+          withoutPillar: { pillarUrl: undefined },
+        },
+      },
+      freshness: { stale: ['https://site.test/pillar'] },
+      coverage: [{ bestUrl: 'https://site.test/pillar', entitiesMissing: ['schema', 'author'] }],
+    } as never;
+    const alerts = contentDecay(report);
+    expect(alerts).toEqual([{ code: 'content-decay', params: { url: 'https://site.test/pillar', missing: 2 } }]);
+  });
+
+  it('covers buildTopicalBenchmark tie-breaker sort on line 24 and trailing pillars on line 31', () => {
+    const pages = ownSite();
+    const taxonomy = referenceTaxonomy(pages)!;
+    const own = buildAuthorityReport(pages, `https://${OWN_HOST}/`, ownReport(pages), { taxonomy, now: NOW });
+
+    const competitors: CompetitorPages[] = [
+      { domain: 'beta-comp.test', pages: ownSite() },
+      { domain: 'alpha-comp.test', pages: ownSite() },
+    ];
+
+    // Weak own coverage on 'pour' creates trailing pillars where margin(pillar) < 0
+    const weakOwn = {
+      ...own,
+      tas: own.tas, // same tas as competitors to trigger tie-breaker domain sort
+      pillarCoverage: [
+        { id: 'pour', label: 'Pour', subtopics: 1, coveragePct: 0, gaps: 1, shallow: 0 },
+        { id: 'general', label: 'General', subtopics: 1, coveragePct: 10, gaps: 1, shallow: 0 },
+      ],
+    };
+
+    const benchmark = buildTopicalBenchmark(weakOwn as never, OWN_HOST, competitors, taxonomy, NOW);
+    const benchmarkReversed = buildTopicalBenchmark(weakOwn as never, OWN_HOST, [competitors[1], competitors[0]], taxonomy, NOW);
+    expect(benchmark).not.toBeNull();
+    expect(benchmark?.rows.length).toBe(3);
+    expect(benchmarkReversed?.rows.length).toBe(3);
+    expect(benchmark?.insights.some((i) => i.code === 'trailing-pillars')).toBe(true);
+  });
+
+  it('covers buildTopics pair truncation on line 46', () => {
+    const documents: DiagnosisDocument[] = Array.from({ length: 501 }, (_, i) => ({
+      id: `doc-${i}`,
+      role: 'content',
+      url: `https://site.test/p${i}`,
+      finalUrl: `https://site.test/p${i}`,
+      title: `Page ${i}`,
+      headings: [],
+      terms: new Set(['term1', 'term2']),
+      titleTerms: ['en:term1'],
+      titleForms: new Map([['en:term1', 'Term1']]),
+      primaryPage: { language: 'en' },
+      pages: [],
+    } as never));
+    const stats = {
+      idf: () => 1,
+      isTopical: () => true,
+      documentFrequency: new Map(),
+      comparable: 501,
+    };
+    const result = buildTopics(documents, new Map(), stats as never, () => 1);
+    expect(result.truncated).toBe(true);
+    expect(result.pairs.length).toBe(124_750);
+  });
+});
