+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { AIService } from '@/services/ai';
+import { useAuthStore } from '@/stores/authStore';
+import { useProjectStore } from '@/stores/projectStore';
+import { readLlmSpend, writeLlmBudget } from '@/services/llmEconomy/llmBudget';
+import { clearExactCache } from '@/services/llmEconomy/semanticCache';
+
+const P = 'p_app_integration';
+
+const mockResponse = (text: string) =>
+  new Response(JSON.stringify({ choices: [{ message: { content: text } }] }), {
+    status: 200, headers: { 'Content-Type': 'application/json' },
+  });
+
+beforeEach(() => {
+  localStorage.clear();
+  clearExactCache();
+  useProjectStore.setState({ activeProjectId: P });
+  useAuthStore.setState({
+    provider: 'openai',
+    model: 'gpt-4o',
+    apiKeys: { openai: 'test-key', claude: '', gemini: '' },
+    connectionStatus: { openai: 'connected', claude: 'unconfigured', gemini: 'unconfigured' },
+    connectionMethod: { openai: 'api_key', claude: 'api_key', gemini: 'api_key' },
+  });
+});
+
+describe('AIService and store integration with LLM economy', () => {
+  it('routes AIService.generateText through project budget and exact cache', async () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 80 });
+
+    const fetchMock = vi.fn().mockImplementation(async () => mockResponse('Generated text'));
+    vi.stubGlobal('fetch', fetchMock);
+
+    // Call 1: Miss
+    const res1 = await AIService.generateText('openai', 'test-key', 'gpt-4o', 'Summarize this page', 'api_key', {
+      projectId: P, estimatedCostUsd: 0.05, actualCostUsd: 0.05,
+    });
+    expect(res1).toBe('Generated text');
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+
+    const spend1 = readLlmSpend(P);
+    expect(spend1.spentUsd).toBe(0.05);
+    expect(spend1.calls).toBe(1);
+    expect(spend1.cacheHits).toBe(0);
+
+    // Call 2: Exact repeat hit within project
+    const res2 = await AIService.generateText('openai', 'test-key', 'gpt-4o', 'Summarize this page', 'api_key', {
+      projectId: P, estimatedCostUsd: 0.05,
+    });
+    expect(res2).toBe('Generated text');
+    expect(fetchMock).toHaveBeenCalledTimes(1); // No new network call
+
+    const spend2 = readLlmSpend(P);
+    expect(spend2.spentUsd).toBe(0.05);
+    expect(spend2.savedUsd).toBe(0.05);
+    expect(spend2.calls).toBe(2);
+    expect(spend2.cacheHits).toBe(1);
+
+    vi.unstubAllGlobals();
+  });
+
+  it('routes through cosine semantic cache when comparable vector is provided', async () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 80 });
+
+    const fetchMock = vi.fn().mockImplementation(async () => mockResponse('Semantic response'));
+    vi.stubGlobal('fetch', fetchMock);
+
+    // Store entry with vector [1, 0, 0]
+    await AIService.generateText('openai', 'test-key', 'gpt-4o', 'What is SEO?', 'api_key', {
+      projectId: P, estimatedCostUsd: 0.04, actualCostUsd: 0.04, vector: [1, 0, 0],
+    });
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+
+    // Query with close vector [0.99, 0.01, 0] (cosine > 0.95 threshold) but slightly different wording
+    const semHit = await AIService.generateText('openai', 'test-key', 'gpt-4o', 'Explain SEO concept', 'api_key', {
+      projectId: P, estimatedCostUsd: 0.04, vector: [0.99, 0.01, 0],
+    });
+    expect(semHit).toBe('Semantic response');
+    expect(fetchMock).toHaveBeenCalledTimes(1); // Served from cosine semantic cache
+
+    const spend = readLlmSpend(P);
+    expect(spend.cacheHits).toBe(1);
+    expect(spend.savedUsd).toBe(0.04);
+
+    vi.unstubAllGlobals();
+  });
+
+  it('blocks useAuthStore.generateText when project budget is exceeded', async () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 0.06, warnAtPercent: 80 });
+
+    const fetchMock = vi.fn().mockImplementation(async () => mockResponse('Response'));
+    vi.stubGlobal('fetch', fetchMock);
+
+    // First call uses $0.05 of $0.06 budget
+    await AIService.generateText('openai', 'test-key', 'gpt-4o', 'Initial prompt', 'api_key', {
+      projectId: P, actualCostUsd: 0.05, estimatedCostUsd: 0.05,
+    });
+
+    // Second call without cost estimate under budget cap must be blocked
+    await expect(useAuthStore.getState().generateText('Next unpriced prompt'))
+      .rejects.toThrow();
+
+    vi.unstubAllGlobals();
+  });
+});
diff --git a/tests/llmEconomyBudget.test.ts b/tests/llmEconomyBudget.test.ts
new file mode 100644
index 00000000..3f126c26
--- /dev/null
+++ b/tests/llmEconomyBudget.test.ts
@@ -0,0 +1,96 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import i18n from '@/i18n';
+import {
+  llmBudgetStatus, monthKey, readLlmBudget, readLlmSpend, readLlmUsageSummary,
+  recordLlmCost, withinProjectBudget, writeLlmBudget, LLM_ECONOMY_EVENT,
+} from '@/services/llmEconomy/llmBudget';
+
+const P = 'proj_test_1';
+const oct = new Date(2026, 9, 15, 12);
+
+beforeEach(async () => {
+  localStorage.clear();
+  await i18n.changeLanguage('en');
+});
+afterEach(() => vi.restoreAllMocks());
+
+describe('llmBudget settings', () => {
+  it('defaults to no monthly limit and 80% warning', () => {
+    expect(readLlmBudget(P)).toEqual({ monthlyLimitUsd: null, warnAtPercent: 80 });
+  });
+
+  it('writes valid limits and rejects invalid ones', () => {
+    expect(writeLlmBudget(P, { monthlyLimitUsd: 50, warnAtPercent: 90 })).toEqual({ monthlyLimitUsd: 50, warnAtPercent: 90 });
+    expect(readLlmBudget(P)).toEqual({ monthlyLimitUsd: 50, warnAtPercent: 90 });
+    expect(() => writeLlmBudget(P, { monthlyLimitUsd: -5, warnAtPercent: 80 })).toThrow();
+    expect(() => writeLlmBudget(P, { monthlyLimitUsd: 200_000, warnAtPercent: 80 })).toThrow();
+    expect(() => writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 0 })).toThrow();
+    expect(() => writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 101 })).toThrow();
+    localStorage.setItem(`seomi_project_${P}_llm_budget_v1`, '{"monthlyLimitUsd":"bad"}');
+    expect(readLlmBudget(P)).toEqual({ monthlyLimitUsd: null, warnAtPercent: 80 });
+  });
+});
+
+describe('llmSpend tracking and privacy', () => {
+  it('records spend, savings and cache hits without leaking private text to storage', () => {
+    const listener = vi.fn();
+    window.addEventListener(LLM_ECONOMY_EVENT, listener);
+    recordLlmCost(P, { providerId: 'openai', model: 'gpt-4o', costUsd: 0.05 }, oct);
+    recordLlmCost(P, { providerId: 'ollama', model: 'llama3', costUsd: 0.02, local: true }, oct);
+    recordLlmCost(P, { providerId: 'openai', model: 'gpt-4o', costUsd: 0.05, savedUsd: 0.05, cached: true }, oct);
+    window.removeEventListener(LLM_ECONOMY_EVENT, listener);
+
+    const spend = readLlmSpend(P, oct);
+    expect(spend.month).toBe('2026-10');
+    expect(spend.spentUsd).toBe(0.05);
+    expect(spend.savedUsd).toBe(0.07);
+    expect(spend.cacheHits).toBe(1);
+    expect(spend.calls).toBe(3);
+    expect(spend.lastCostByProvider.openai).toBe(0.05);
+    expect(spend.lastCall?.providerId).toBe('openai');
+    expect(spend.lastCall?.cached).toBe(true);
+    expect(listener).toHaveBeenCalledTimes(3);
+
+    const rawStored = localStorage.getItem(`seomi_project_${P}_llm_spend_v1`) ?? '';
+    expect(rawStored).not.toContain('prompt');
+    expect(rawStored).not.toContain('secret');
+  });
+
+  it('resets month-to-date counters across new months while keeping provider costs', () => {
+    recordLlmCost(P, { providerId: 'claude', costUsd: 1.5 }, new Date(2026, 8, 30));
+    const next = readLlmSpend(P, oct);
+    expect(next.month).toBe(monthKey(oct));
+    expect(next.spentUsd).toBe(0);
+    expect(next.calls).toBe(0);
+    expect(next.lastCostByProvider.claude).toBe(1.5);
+  });
+
+  it('reports status levels and guards next calls', () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 80 });
+    expect(withinProjectBudget(P, 5)).toBe(true);
+    recordLlmCost(P, { providerId: 'openai', costUsd: 8.5 }, oct);
+    const spend = readLlmSpend(P, oct);
+    const budget = readLlmBudget(P);
+    const status = llmBudgetStatus(spend, budget);
+    expect(status.level).toBe('warning');
+    expect(status.remainingUsd).toBe(1.5);
+    expect(withinProjectBudget(P, 2)).toBe(false);
+
+    recordLlmCost(P, { providerId: 'openai', costUsd: 2 }, oct);
+    expect(llmBudgetStatus(readLlmSpend(P, oct), budget).level).toBe('exceeded');
+  });
+
+  it('produces a summary compatible with costMeter', () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 80 });
+    recordLlmCost(P, { providerId: 'openai', costUsd: 2, savedUsd: 1, cached: true }, oct);
+    const summary = readLlmUsageSummary(P, oct);
+    expect(summary).toEqual({
+      spentUsd: 0,
+      savedUsd: 1,
+      cacheHits: 1,
+      calls: 1,
+      remainingUsd: 10,
+      overBudget: false,
+    });
+  });
+});
diff --git a/tests/llmEconomyBudgetEdgeCases.test.ts b/tests/llmEconomyBudgetEdgeCases.test.ts
new file mode 100644
index 00000000..4f904751
--- /dev/null
+++ b/tests/llmEconomyBudgetEdgeCases.test.ts
@@ -0,0 +1,110 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import * as storageModule from '@/services/storage';
+import {
+  clearProjectLlmBudgetAndSpend,
+  llmBudgetStatus,
+  readLlmBudget,
+  readLlmSpend,
+  recordLlmCost,
+  withinProjectBudget,
+  writeLlmBudget,
+} from '@/services/llmEconomy/llmBudget';
+
+const P = 'p_edge_cases';
+const oct = new Date(2026, 9, 20);
+
+beforeEach(() => {
+  localStorage.clear();
+});
+
+describe('llmBudget edge cases and fault tolerance', () => {
+  it('handles array, null, and corrupt JSON in storage safely', () => {
+    localStorage.setItem(`seomi_project_${P}_llm_budget_v1`, '["not", "an", "object"]');
+    expect(readLlmBudget(P)).toEqual({ monthlyLimitUsd: null, warnAtPercent: 80 });
+
+    localStorage.setItem(`seomi_project_${P}_llm_budget_v1`, '{bad json');
+    expect(readLlmBudget(P)).toEqual({ monthlyLimitUsd: null, warnAtPercent: 80 });
+
+    localStorage.setItem(`seomi_project_${P}_llm_spend_v1`, 'null');
+    expect(readLlmSpend(P, oct)).toMatchObject({ spentUsd: 0, calls: 0, lastCall: null });
+
+    localStorage.setItem(`seomi_project_${P}_llm_spend_v1`, '{corrupt');
+    expect(readLlmSpend(P, oct)).toMatchObject({ spentUsd: 0, calls: 0, lastCall: null });
+  });
+
+  it('tolerates partial lastCall and non-integer counters in spend record', () => {
+    localStorage.setItem(
+      `seomi_project_${P}_llm_spend_v1`,
+      JSON.stringify({
+        month: '2026-10',
+        spentUsd: 1.5,
+        savedUsd: 0.5,
+        cacheHits: 'invalid',
+        calls: null,
+        lastCostByProvider: { openai: 1.5, bad: 'text' },
+        lastCall: { providerId: 'openai', costUsd: 1.5, at: '2026-10-20T10:00:00.000Z' },
+      }),
+    );
+    const spend = readLlmSpend(P, oct);
+    expect(spend.calls).toBe(0);
+    expect(spend.cacheHits).toBe(0);
+    expect(spend.lastCostByProvider).toEqual({ openai: 1.5 });
+    expect(spend.lastCall?.providerId).toBe('openai');
+    expect(spend.lastCall?.model).toBeUndefined();
+
+    localStorage.setItem(
+      `seomi_project_${P}_llm_spend_v1`,
+      JSON.stringify({ month: '2026-10', lastCall: { providerId: 'openai', costUsd: -1, at: 123 } }),
+    );
+    expect(readLlmSpend(P, oct).lastCall).toBeNull();
+  });
+
+  it('handles zero budget limit edge cases and ok status level', () => {
+    const zeroSpend = { month: '2026-10', spentUsd: 0, savedUsd: 0, cacheHits: 0, calls: 0, lastCostByProvider: {}, lastCall: null };
+    const positiveSpend = { ...zeroSpend, spentUsd: 0.01 };
+    const zeroBudget = { monthlyLimitUsd: 0, warnAtPercent: 80 };
+
+    expect(llmBudgetStatus(zeroSpend, zeroBudget)).toEqual({ level: 'exceeded', percent: 0, remainingUsd: 0 });
+    expect(llmBudgetStatus(positiveSpend, zeroBudget)).toEqual({ level: 'exceeded', percent: 100, remainingUsd: 0 });
+    expect(llmBudgetStatus({ ...zeroSpend, spentUsd: 4 }, { monthlyLimitUsd: 10, warnAtPercent: 80 })).toEqual({ level: 'ok', percent: 40, remainingUsd: 6 });
+  });
+
+  it('falls back to raw cost when local call does not specify savedUsd and handles non-finite cost', () => {
+    recordLlmCost(P, { providerId: 'ollama', costUsd: 0.07, local: true }, oct);
+    expect(readLlmSpend(P, oct).savedUsd).toBe(0.07);
+
+    recordLlmCost(P, { providerId: 'openai', costUsd: Number.NaN }, oct);
+    expect(readLlmSpend(P, oct).calls).toBe(2);
+  });
+
+  it('survives storage write failure gracefully', () => {
+    const spy = vi.spyOn(storageModule, 'writeStorage').mockImplementation(() => {
+      throw new Error('QuotaExceeded');
+    });
+    expect(() => recordLlmCost(P, { providerId: 'openai', costUsd: 0.1 }, oct)).not.toThrow();
+    spy.mockRestore();
+  });
+
+  it('clears budget and spend via clearProjectLlmBudgetAndSpend', () => {
+    writeLlmBudget(P, { monthlyLimitUsd: 15, warnAtPercent: 80 });
+    recordLlmCost(P, { providerId: 'openai', costUsd: 2 });
+    clearProjectLlmBudgetAndSpend(P);
+    expect(readLlmBudget(P).monthlyLimitUsd).toBeNull();
+    expect(readLlmSpend(P).spentUsd).toBe(0);
+  });
+
+  it('checks budget without specifying date argument', () => {
+    expect(withinProjectBudget(P, 5)).toBe(true);
+  });
+
+  it('covers null budget status, null cost in withinProjectBudget, and cached call with null cost', () => {
+    const zeroSpend = { month: '2026-10', spentUsd: 0, savedUsd: 0, cacheHits: 0, calls: 0, lastCostByProvider: {}, lastCall: null };
+    expect(llmBudgetStatus(zeroSpend, { monthlyLimitUsd: null, warnAtPercent: 80 })).toEqual({ level: 'none', percent: null, remainingUsd: null });
+
+    writeLlmBudget(P, { monthlyLimitUsd: 10, warnAtPercent: 80 });
+    expect(withinProjectBudget(P, null)).toBe(false);
+
+    recordLlmCost(P, { providerId: 'openai', costUsd: null, cached: true }, oct);
+    expect(readLlmSpend(P, oct).calls).toBe(1);
+  });
+});
